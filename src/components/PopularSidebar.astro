---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<div class="sidebar-widget">
  {/*
    🔴 見出しは「よく読まれている記事」ではない（2026-09-05 是正）。
       閲覧数は貯まっているが、その表の SELECT 権限は service_role だけ＝
       ブラウザ（anon）からは **必ず 403** で、この欄は公開初日から一度も
       閲覧数順になったことがなかった。res.ok を見て黙って諦める作りだったので、
       画面には新着順が出たまま、見出しだけが嘘をついていた。
       閲覧数は開発者ダッシュボード（ポータル記事アクセス）で読む＝訪問者には出さない。
  */}
  <h3 class="widget-title">新着記事</h3>
  <ol class="popular-list">
    {posts.map((post, i) => (
      <li>
        <a href={`/blog/${post.slug}/`}>
          <span class="popular-rank">{i + 1}</span>
          <span class="popular-text">{post.data.title}</span>
        </a>
      </li>
    ))}
  </ol>
</div>
<style>
  .sidebar-widget {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow-xs);
  }

  .widget-title {
    font-size: 14px;
    font-weight: 800;
    color: var(--text);
    padding-bottom: 10px;
    border-bottom: 3px solid var(--accent);
    margin-bottom: 4px;
    letter-spacing: -.01em;
  }

  .popular-list {
    list-style: none;
    padding: 0;
  }

  .popular-list li {
    border-bottom: 1px solid var(--border-light);
  }

  .popular-list li:last-child {
    border-bottom: none;
  }

  .popular-list a {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 0;
    color: var(--text);
    text-decoration: none;
    transition: color .15s;
    flex-wrap: wrap;
  }

  .popular-list a:hover {
    color: var(--accent-text);
    text-decoration: none;
  }

  .popular-rank {
    font-size: 18px;
    font-weight: 900;
    color: var(--accent-text);
    min-width: 22px;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .popular-list li:nth-child(n + 4) .popular-rank {
    color: var(--text-dim);
  }

  .popular-text {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    flex: 1;
    min-width: 0;
  }

</style>
